# ==============================================
# Shell
# ==============================================
command = /opt/homebrew/bin/zsh

# ==============================================
# Font | 字体
# ==============================================
# 主字体：JetBrainsMono Nerd Font Patch（图标兼容性优于 Monaspace Neon）
# 回退字体：LXGW WenKai Mono GB（中文显示）
font-family = "JetBrainsMono NFP, LXGW WenKai Mono GB"
font-size = 12

# OpenType 特性
font-feature = liga
font-feature = calt
font-feature = zero
font-feature = ss01
font-feature = ss02

# ==============================================
# Color Palette | Ayu Mirage
# ==============================================
foreground = #cccac2
background = #1f2430

cursor-color = #ffcc66
cursor-text = #1f2430
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.95

# 16 色 ANSI 调色板
palette = 0=#171b24
palette = 1=#ed8274
palette = 2=#87d96c
palette = 3=#facc6e
palette = 4=#6dcbfa
palette = 5=#dabafa
palette = 6=#90e1c6
palette = 7=#c7c7c7
palette = 8=#686868
palette = 9=#f28779
palette = 10=#d5ff80
palette = 11=#ffd173
palette = 12=#73d0ff
palette = 13=#dfbfff
palette = 14=#95e6cb
palette = 15=#ffffff

selection-background = #274364
selection-foreground = #cccac2

# ==============================================
# Custom Shader | 光标特效
# ==============================================
custom-shader = "~/.config/ghostty/shaders/cursor_smear.glsl"

# ==============================================
# Background Image & Transparency | 背景与透明
# ==============================================
background-image = ~/Pictures/Wallpaper/Apps/ghostty.png
background-image-fit = cover
background-image-position = center
background-image-opacity = 0.25
background-opacity = 0.85
background-blur = 18
background-opacity-cells = false

# ==============================================
# Window & Padding | 窗口
# ==============================================
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = transparent

# ==============================================
# Behavior | 行为
# ==============================================
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
quit-after-last-window-closed = true
unfocused-split-opacity = 0.75

# ==============================================
# Misc | 杂项
# ==============================================
term = xterm-256color
