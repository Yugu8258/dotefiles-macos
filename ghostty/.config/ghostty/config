# ==============================================
# Shell
# ==============================================
# 指定启动的 shell 程序
command = /opt/homebrew/bin/zsh

# ==============================================
# Font | 字体设置（统一为粗体）
# ==============================================
# 主字体：JetBrainsMono Nerd Font Patch 粗体
# 注意：同一配置项只保留一行，后值会覆盖前值
# ==============================================
# 可选：字体回退（如需中文/符号回退，取消注释并删除上方 font-family 行）
# ==============================================
# Ghostty 支持用逗号分隔的字体列表，按顺序回退：
# font-family = JetBrainsMono NFP Bold, LXGW WenKai Mono GB, Symbols Nerd Font
font-family = "Monaspace Neon, LXGW WenKai Mono GB"
# 粗体字形同样使用 JetBrainsMono NFP Bold
# font-family-bold = "JetBrainsMono NFP Bold"
# 字体样式强制为粗体
font-style = bold
# 字号（单位：pt）
font-size = 12
# 启用连字（ligature）
font-feature = liga
# 启用上下文替代（contextual alternates），连字生效常需此项
font-feature = calt
# 带斜杠的零，便于区分 0 与 O
font-feature = zero
# 风格集 01（JetBrains Mono 的替代字形）
font-feature = ss01
# 风格集 02
font-feature = ss02

# ==============================================
# Color Palette | Ayu Moon (Ayu Mirage) 配色
# ==============================================
# 默认前景色（文字）
foreground = #cccac2
# 默认背景色
background = #1f2430

# 光标颜色
cursor-color = #ffcc66
# 光标下文字颜色（块状光标时生效）
cursor-text = #1f2430
# 光标形状：block 块状 / bar 竖线 / underline 下划线
cursor-style = block
# 光标是否闪烁（合并了原文件两处重复设置，最终以 true 为准）
cursor-style-blink = true
# 光标不透明度（0.0~1.0）
cursor-opacity = 0.95

# 16 色 ANSI 调色板（0~7 普通色，8~15 亮色）
palette = 0=#171b24
palette = 1=#ed8274
palette = 2=#87d96c
palette = 3=#facc6e
palette = 4=#6dcbfa
palette = 5=#dabafa
palette = 6=#90e1c6
palette = 7=#c7c7c7
palette = 8=#686868
palette = 9=#f28779
palette = 10=#d5ff80
palette = 11=#ffd173
palette = 12=#73d0ff
palette = 13=#dfbfff
palette = 14=#95e6cb
palette = 15=#ffffff

# 选中文本的背景色 / 前景色
selection-background = #274364
selection-foreground = #cccac2

# ==============================================
# Custom Shader | 自定义着色器
# ==============================================
# 光标拖尾/涂抹特效的 GLSL 着色器文件
custom-shader = "~/.config/ghostty/shaders/cursor_smear.glsl"

# ==============================================
# Background Image & Transparency | 背景图与透明
# ==============================================
# 背景图片路径
background-image = ~/Pictures/Wallpaper/Apps/ghostty.png
# 图片填充方式：cover 铺满并裁剪 / contain 完整显示 / stretch 拉伸
background-image-fit = cover
# 图片对齐位置
background-image-position = center
# 背景图片不透明度（0.0 全透明 ~ 1.0 不透明）
background-image-opacity = 0.25
# 终端整体背景不透明度（0.0 全透明 ~ 1.0 不透明）
background-opacity = 0.85
# 背景模糊半径（像素）
background-blur = 18
# 是否让每个单元格背景也应用透明度（false 表示仅整体背景透明）
background-opacity-cells = false

# ==============================================
# Window & Padding | 窗口与内边距
# ==============================================
# 左右内边距（像素）
window-padding-x = 12
# 上下内边距（像素）
window-padding-y = 10
# 自动平衡内边距，使内容居中
window-padding-balance = true
# macOS 标题栏样式：transparent 透明 / native 原生 / hidden 隐藏
macos-titlebar-style = transparent

# ==============================================
# Behavior | 行为
# ==============================================
# 选中文本后自动复制到系统剪贴板
copy-on-select = clipboard
# 打字时隐藏鼠标指针
mouse-hide-while-typing = true
# 关闭窗口时不再弹出确认提示
confirm-close-surface = false
# 最后一个窗口关闭后退出程序
quit-after-last-window-closed = true
# 非聚焦分屏的不透明度
unfocused-split-opacity = 0.75

# ==============================================
# Misc | 杂项
# ==============================================
# 终端类型标识
term = xterm-256color
